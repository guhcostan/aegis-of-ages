{
  "name": "aegis-of-ages",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aegis of Ages - a browser RTS with deterministic simulation, 3D rendering and AoE-style HUD.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --dry 2>/dev/null || tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "deploy": "wrangler deploy",
    "sim:headless": "tsx scripts/headless-match.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
